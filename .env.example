# Copy this file to .env and change every value. Never share or commit .env.

# PIN typed on the iPad to open the POS (use 6+ digits)
POS_PIN=
# PIN typed on the barista bar's tablet (optional; without it the bar uses Face ID / fingerprint)
BARISTA_PIN=
# PIN typed on the inventory screen (optional; without it, use Face ID / fingerprint)
INVENTORY_PIN=
# PIN typed on the kitchen screen
KITCHEN_PIN=
# Owner's password for the admin panel (opens every screen)
ADMIN_PASSWORD=
# Long random string used to sign logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional
# TAX_RATE=0.12
# Printed receipts. Separate several lines with |
# RECEIPT_NAME=Café Ambiente
# RECEIPT_HEADER=123 Rizal St, Manila|TIN 000-000-000-000
# RECEIPT_FOOTER=Thank you! Please come again.|This is not an official receipt
# The barista bar's receipts (header defaults to RECEIPT_HEADER)
# BARISTA_RECEIPT_TITLE=Coffee Bar
# BARISTA_RECEIPT_HEADER=123 Rizal St, Manila
# BARISTA_RECEIPT_FOOTER=Listen for your number at the bar.|Enjoy your coffee!
# PORT=3000
# Time zone that decides when "today" starts on the admin panel (matters on cloud servers)
TZ=Asia/Manila
# Set to 1 only when running behind a hosting provider's HTTPS proxy
# TRUST_PROXY=1
# Face ID / fingerprint sign-in works on the address it was set up on. Only set these if
# the app is reached through a different address than the browser shows (rare).
# RP_ID=yourapp.up.railway.app
# RP_ORIGIN=https://yourapp.up.railway.app
