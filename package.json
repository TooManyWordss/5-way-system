{
  "name": "five-way-system",
  "version": "0.1.0",
  "private": true,
  "description": "POS, live kitchen display and admin panel sharing one backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server.js\" \"vite --config vite.config.ts\"",
    "build": "vite build --config vite.config.ts",
    "dev:server": "node --watch --env-file-if-exists=.env server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
